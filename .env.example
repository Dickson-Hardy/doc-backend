# Node Environment
NODE_ENV=development

# PostgreSQL (Supabase)
DATABASE_HOST=your-project.supabase.com
DATABASE_PORT=5432
DATABASE_USER=postgres.your-project-ref
DATABASE_PASSWORD=your-password
DATABASE_NAME=postgres

# MongoDB (Atlas) - for member lookups only
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/live?retryWrites=true&w=majority

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_API_URL=https://api.paystack.co

# Frontend URL (for payment callbacks)
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP Configuration (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=CMDA Conference <your-email@gmail.com>
REPLY_TO=conference@cmdanigeria.org

# JWT Secret (change this to a random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
